---
import { Icon } from 'astro-icon/components';
---

<section class="cta" id="contact">
	<div class="container cta-inner" data-reveal>
		<h2 class="cta-heading">Have a project in mind?</h2>
		<p class="cta-copy">Tell us what you're building. We reply within one business day.</p>
		<div class="cta-actions">
			<a
				href="mailto:hello@loamstudio.co?subject=New%20project%20inquiry"
				class="btn btn-cta"
			>
				Start a project
				<Icon name="ph:arrow-right" />
			</a>
			<a href="mailto:hello@loamstudio.co" class="cta-email">hello@loamstudio.co</a>
		</div>
	</div>
</section>

<style>
	.cta {
		margin-inline: var(--edge-padding);
		margin-block: clamp(1.5rem, 4vw, 3rem);
		border-radius: clamp(20px, 3vw, 32px);
		background: var(--accent);
		color: var(--accent-ink);
		overflow: hidden;
		position: relative;
	}

	.cta::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(120% 140% at 8% 0%, oklch(100% 0 0 / 0.16), transparent 55%),
			radial-gradient(90% 120% at 100% 100%, oklch(0% 0 0 / 0.14), transparent 60%);
		pointer-events: none;
	}

	.cta-inner {
		position: relative;
		padding-block: clamp(3.5rem, 8vw, 6rem);
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.cta-heading {
		font-size: clamp(2.1rem, 4.6vw, 3.4rem);
		color: var(--accent-ink);
		max-width: 18ch;
	}

	.cta-copy {
		margin-top: 1rem;
		font-size: 1.1rem;
		color: oklch(16% 0.03 45 / 0.75);
		max-width: 36ch;
	}

	.cta-actions {
		margin-top: 2.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.btn-cta {
		background: var(--accent-ink);
		color: var(--accent);
		padding: 1rem 1.9rem;
		font-size: 1rem;
	}

	.btn-cta:hover {
		background: oklch(22% 0.03 45);
	}

	.btn-cta :global(svg) {
		width: 18px;
		height: 18px;
	}

	.cta-email {
		font-size: 0.95rem;
		font-weight: 600;
		color: oklch(16% 0.03 45 / 0.8);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.cta-email:hover {
		color: var(--accent-ink);
	}
</style>
