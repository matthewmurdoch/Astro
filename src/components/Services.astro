---
import { Icon } from 'astro-icon/components';

const services = [
	{
		icon: 'ph:palette',
		title: 'Brand & identity',
		copy: 'Naming, visual identity systems, and brand guidelines that hold up across every surface.',
	},
	{
		icon: 'ph:code',
		title: 'Web design & development',
		copy: 'Custom, fast, accessible websites built to convert, not just to look good in a portfolio.',
	},
	{
		icon: 'ph:cursor-click',
		title: 'Product design',
		copy: 'Interfaces for SaaS and consumer products, from first wireframe through shipped feature.',
	},
	{
		icon: 'ph:shopping-cart-simple',
		title: 'E-commerce',
		copy: 'Storefronts on Shopify or headless stacks, tuned against real conversion data.',
	},
	{
		icon: 'ph:stack-simple',
		title: 'Design systems',
		copy: 'Component libraries and documentation that keep design and engineering moving in sync.',
	},
];
---

<section class="services-pin" id="services" style={`--pin-count: ${services.length}`}>
	<div class="services-pin-frame">
		<div class="container services-grid">
			<div class="services-intro" data-reveal>
				<h2 class="services-heading">What we do</h2>
				<p class="services-copy">
					A compact team that handles the whole arc, from early positioning to the interface
					people actually use.
				</p>
				<div class="services-rail" data-services-rail aria-hidden="true">
					{services.map((_, i) => <span class:list={['rail-dot', i === 0 && 'is-active']} data-rail-dot={i} />)}
				</div>
			</div>

			<div class="services-list" data-services-list>
				{
					services.map((service, i) => (
						<div class:list={['service-row', i === 0 && 'is-active']} data-service-row={i}>
							<span class="service-index">{String(i + 1).padStart(2, '0')}</span>
							<span class="service-icon">
								<Icon name={service.icon} />
							</span>
							<span class="service-title">{service.title}</span>
							<span class="service-copy">{service.copy}</span>
						</div>
					))
				}
			</div>
		</div>
	</div>

	<div class="services-triggers" data-services-triggers aria-hidden="true">
		{services.map((_, i) => <span class="services-trigger" data-service-trigger={i} />)}
	</div>
</section>

<style>
	.services-pin {
		position: relative;
		border-block-start: 1px solid var(--border);
		padding-block: clamp(4rem, 8vw, 7rem);
	}

	.services-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
		gap: clamp(2.5rem, 5vw, 5rem);
	}

	.services-heading {
		font-size: clamp(1.9rem, 3.2vw, 2.6rem);
	}

	.services-copy {
		margin-top: 1rem;
		max-width: 32ch;
		color: var(--ink-muted);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.services-rail {
		display: none;
	}

	.services-list {
		display: flex;
		flex-direction: column;
	}

	.service-row {
		display: grid;
		grid-template-columns: auto auto minmax(0, 15rem) 1fr;
		align-items: center;
		gap: clamp(1.1rem, 2.6vw, 2rem);
		padding-block: 1.9rem;
		border-bottom: 1px solid var(--border);
		transition: padding-inline-start 260ms var(--ease-out);
	}

	.service-row:hover {
		padding-inline-start: 0.5rem;
	}

	.service-row:first-child {
		padding-block-start: 0;
	}

	.service-index {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--ink-faint);
	}

	.service-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 46px;
		height: 46px;
		border-radius: var(--radius-input);
		background: var(--accent-soft);
		color: var(--accent);
		flex-shrink: 0;
		transition:
			background-color 300ms var(--ease-out),
			transform 300ms var(--ease-out);
	}

	.service-icon :global(svg) {
		width: 22px;
		height: 22px;
	}

	.service-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.2rem;
		letter-spacing: -0.01em;
	}

	.service-copy {
		color: var(--ink-muted);
		font-size: 0.98rem;
		line-height: 1.55;
		max-width: 44ch;
	}

	.services-triggers {
		display: none;
	}

	/* Pin behaviour: desktop only. Mobile keeps normal document flow. */
	@media (min-width: 900px) {
		.services-pin {
			height: calc(100vh + (var(--pin-count) * 60vh));
			padding-block: 0;
			border-block-start: none;
		}

		.services-pin-frame {
			position: sticky;
			top: 0;
			height: 100vh;
			display: flex;
			align-items: center;
			border-block-start: 1px solid var(--border);
		}

		.services-rail {
			display: flex;
			flex-direction: column;
			gap: 0.65rem;
			margin-top: 2.25rem;
		}

		.rail-dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: var(--border-strong);
			transition:
				background-color 300ms var(--ease-out),
				transform 300ms var(--ease-out);
		}

		.rail-dot.is-active {
			background: var(--accent);
			transform: scale(1.6);
		}

		.service-row {
			opacity: 0.35;
			filter: saturate(0.6);
			transition:
				opacity 380ms var(--ease-out),
				filter 380ms var(--ease-out),
				padding-inline-start 260ms var(--ease-out);
		}

		.service-row.is-active {
			opacity: 1;
			filter: saturate(1);
		}

		.service-row.is-active .service-icon {
			background: var(--accent);
			color: var(--accent-ink);
			transform: scale(1.06);
		}

		.services-triggers {
			display: flex;
			flex-direction: column;
			position: absolute;
			inset: 0;
			z-index: -1;
			pointer-events: none;
		}

		.services-trigger {
			flex: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.service-row {
			transition: opacity 150ms linear;
		}
	}

	@media (max-width: 900px) {
		.services-grid {
			grid-template-columns: 1fr;
		}

		.service-row {
			grid-template-columns: auto auto 1fr;
			grid-template-areas:
				'index icon title'
				'. copy copy';
			row-gap: 0.6rem;
		}

		.service-index {
			grid-area: index;
		}

		.service-icon {
			grid-area: icon;
		}

		.service-title {
			grid-area: title;
		}

		.service-copy {
			grid-area: copy;
			max-width: none;
		}
	}
</style>
