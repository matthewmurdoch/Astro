---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class={className}
	width="30"
	height="30"
	viewBox="0 0 30 30"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<rect x="1" y="1" width="28" height="28" rx="8" stroke="currentColor" stroke-width="1.6" />
	<path d="M9 21V9L15 17.5L21 9V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
</svg>
