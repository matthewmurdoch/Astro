---
interface Props {
	name: string;
	initial: string;
	shape: 'circle' | 'hex' | 'square' | 'diamond';
}

const { name, initial, shape } = Astro.props;
---

<span class="client-mark">
	{
		shape === 'circle' && (
			<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
				<circle cx="11" cy="11" r="9.5" stroke="currentColor" stroke-width="1.4" />
				<text x="11" y="15" text-anchor="middle" font-size="10" fill="currentColor" font-family="var(--font-display)">
					{initial}
				</text>
			</svg>
		)
	}
	{
		shape === 'hex' && (
			<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
				<path d="M11 1L20 6.25V16.75L11 22L2 16.75V6.25L11 1Z" stroke="currentColor" stroke-width="1.4" />
				<text x="11" y="15" text-anchor="middle" font-size="9.5" fill="currentColor" font-family="var(--font-display)">
					{initial}
				</text>
			</svg>
		)
	}
	{
		shape === 'square' && (
			<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
				<rect x="1.5" y="1.5" width="19" height="19" rx="4" stroke="currentColor" stroke-width="1.4" />
				<text x="11" y="15" text-anchor="middle" font-size="10" fill="currentColor" font-family="var(--font-display)">
					{initial}
				</text>
			</svg>
		)
	}
	{
		shape === 'diamond' && (
			<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
				<rect x="3.5" y="3.5" width="15" height="15" rx="2" stroke="currentColor" stroke-width="1.4" transform="rotate(45 11 11)" />
				<text x="11" y="15" text-anchor="middle" font-size="10" fill="currentColor" font-family="var(--font-display)">
					{initial}
				</text>
			</svg>
		)
	}
	<span class="client-name">{name}</span>
</span>

<style>
	.client-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--ink-muted);
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		white-space: nowrap;
		padding-inline: 1.75rem;
	}

	.client-mark svg {
		flex-shrink: 0;
		opacity: 0.85;
	}
</style>
