---
---

<section class="hero" id="top">
	<div class="container hero-grid">
		<div class="hero-copy" data-reveal>
			<h1 class="hero-heading">Websites built like they matter.</h1>
			<p class="hero-sub">
				Loam is a small studio designing and building websites, products, and brand systems for
				companies that refuse to look ordinary.
			</p>
			<div class="hero-actions">
				<a href="#contact" class="btn btn-primary">Start a project</a>
				<a href="#work" class="btn btn-ghost">View our work</a>
			</div>
		</div>

		<div class="hero-visual" data-reveal>
			<div class="hero-mosaic">
				<img
					class="mosaic-tile tile-a"
					src="https://picsum.photos/seed/loam-editorial-craft/620/780"
					width="620"
					height="780"
					alt="Editorial photography from a recent Loam brand project"
					fetchpriority="high"
				/>
				<img
					class="mosaic-tile tile-b"
					src="https://picsum.photos/seed/loam-product-texture/560/420"
					width="560"
					height="420"
					alt="Product texture detail from a Loam design project"
					loading="lazy"
				/>
				<img
					class="mosaic-tile tile-c"
					src="https://picsum.photos/seed/loam-studio-desk/440/440"
					width="440"
					height="440"
					alt="Studio detail shot"
					loading="lazy"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block-start: clamp(2.5rem, 6vw, 5.5rem);
		padding-block-end: clamp(3rem, 7vw, 6rem);
		overflow: hidden;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: center;
	}

	.hero-heading {
		font-size: clamp(2.6rem, 5.4vw, 4.4rem);
		line-height: 1.02;
	}

	.hero-sub {
		margin-top: 1.5rem;
		max-width: 42ch;
		font-size: 1.15rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 2.25rem;
		flex-wrap: wrap;
	}

	.hero-visual {
		position: relative;
		height: clamp(360px, 46vw, 560px);
	}

	.hero-mosaic {
		position: absolute;
		inset: 0;
	}

	.mosaic-tile {
		position: absolute;
		object-fit: cover;
		border-radius: var(--radius-tile);
		box-shadow: 0 30px 60px -25px hsl(var(--shadow-color) / 0.7);
		transition: transform 500ms var(--ease-out);
		will-change: transform;
	}

	.tile-a {
		width: 58%;
		height: 92%;
		top: 4%;
		left: 0;
		transform: rotate(-2.5deg);
	}

	.tile-b {
		width: 46%;
		height: 46%;
		top: 2%;
		right: 0;
		transform: rotate(3deg);
	}

	.tile-c {
		width: 38%;
		height: 40%;
		bottom: 2%;
		right: 8%;
		transform: rotate(-1.5deg);
	}

	@media (max-width: 980px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}

		.hero-visual {
			height: clamp(320px, 90vw, 460px);
			order: -1;
		}
	}

	@media (max-width: 560px) {
		.hero-sub {
			max-width: none;
		}

		.hero-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.hero-actions .btn {
			width: 100%;
		}
	}
</style>
