---
import ClientMark from './ClientMark.astro';
---

<section class="testimonial" id="testimonial">
	<div class="container testimonial-inner" data-reveal>
		<span class="testimonial-glyph" aria-hidden="true">&ldquo;</span>
		<blockquote class="testimonial-quote">
			Loam rebuilt our site in six weeks and our demo requests doubled the following month.
		</blockquote>
		<div class="testimonial-attribution">
			<ClientMark name="Kepler Analytics" initial="K" shape="square" />
			<div class="testimonial-person">
				<span class="testimonial-name">Priya Deshmukh</span>
				<span class="testimonial-role">Head of Marketing, Kepler Analytics</span>
			</div>
		</div>
	</div>
</section>

<style>
	.testimonial {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-block-start: 1px solid var(--border);
	}

	.testimonial-inner {
		max-width: 46rem;
	}

	.testimonial-glyph {
		display: block;
		font-family: var(--font-display);
		font-size: 4.5rem;
		line-height: 1;
		color: var(--accent);
		margin-bottom: 0.5rem;
	}

	.testimonial-quote {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(1.6rem, 3.4vw, 2.35rem);
		line-height: 1.35;
		letter-spacing: -0.015em;
		color: var(--ink);
	}

	.testimonial-attribution {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.testimonial-attribution :global(.client-mark) {
		padding-inline: 0;
	}

	.testimonial-attribution :global(.client-name) {
		display: none;
	}

	.testimonial-attribution :global(svg) {
		width: 34px;
		height: 34px;
		color: var(--accent);
		opacity: 1;
	}

	.testimonial-person {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.testimonial-name {
		font-weight: 600;
		font-size: 0.98rem;
	}

	.testimonial-role {
		font-size: 0.88rem;
		color: var(--ink-faint);
	}
</style>
