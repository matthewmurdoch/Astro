---
import { Icon } from 'astro-icon/components';

const projects = [
	{
		name: 'Hearthline',
		category: 'Brand & website',
		seed: 'loam-hearthline-home',
		w: 900,
		h: 620,
		area: 'a',
	},
	{
		name: 'Northfolk',
		category: 'E-commerce platform',
		seed: 'loam-northfolk-outdoor',
		w: 700,
		h: 900,
		area: 'b',
	},
	{
		name: 'Kepler Analytics',
		category: 'Product design',
		seed: 'loam-kepler-workspace',
		w: 700,
		h: 520,
		area: 'c',
	},
	{
		name: 'Salt & Cedar',
		category: 'Brand identity',
		seed: 'loam-saltcedar-interior',
		w: 700,
		h: 520,
		area: 'd',
	},
	{
		name: 'Foundry Union',
		category: 'Web platform',
		seed: 'loam-foundry-architecture',
		w: 700,
		h: 520,
		area: 'e',
	},
];
---

<section class="work" id="work">
	<div class="container">
		<div class="work-header" data-reveal>
			<h2 class="work-heading">Selected work</h2>
			<a href="#contact" class="work-header-link">
				See how we could help
				<Icon name="ph:arrow-up-right" />
			</a>
		</div>

		<div class="work-grid" data-reveal-group>
			{
				projects.map((project) => (
					<a href="#contact" class={`work-card area-${project.area}`} data-reveal data-tilt>
						<img
							src={`https://picsum.photos/seed/${project.seed}/${project.w}/${project.h}`}
							width={project.w}
							height={project.h}
							alt={`${project.name} project preview`}
							loading="lazy"
						/>
						<span class="work-card-scrim" aria-hidden="true" />
						<span class="work-card-copy">
							<span class="work-card-name">{project.name}</span>
							<span class="work-card-category">{project.category}</span>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.work {
		padding-block: clamp(4rem, 8vw, 7rem);
	}

	.work-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.work-heading {
		font-size: clamp(2rem, 3.6vw, 2.9rem);
	}

	.work-header-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--accent);
		white-space: nowrap;
	}

	.work-header-link :global(svg) {
		width: 18px;
		height: 18px;
		transition: transform 220ms var(--ease-out);
	}

	.work-header-link:hover :global(svg) {
		transform: translate(2px, -2px);
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		grid-template-areas:
			'a a a a b b'
			'a a a a b b'
			'c c d d e e';
		gap: clamp(0.9rem, 1.6vw, 1.35rem);
	}

	.work-card {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: var(--radius-tile);
		text-decoration: none;
		min-height: 200px;
		transition: transform 500ms var(--ease-out);
		will-change: transform;
	}

	.area-a {
		grid-area: a;
	}
	.area-b {
		grid-area: b;
	}
	.area-c {
		grid-area: c;
	}
	.area-d {
		grid-area: d;
	}
	.area-e {
		grid-area: e;
	}

	.work-card img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms var(--ease-out);
	}

	.work-card:hover img {
		transform: scale(1.045);
	}

	.work-card-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 45%, oklch(10% 0.01 264 / 0.82) 100%);
	}

	.work-card-copy {
		position: absolute;
		left: 1.4rem;
		right: 1.4rem;
		bottom: 1.3rem;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.work-card-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.2rem;
		color: var(--ink);
		letter-spacing: -0.01em;
	}

	.work-card-category {
		font-size: 0.88rem;
		color: var(--ink-muted);
	}

	@media (max-width: 860px) {
		.work-grid {
			grid-template-columns: 1fr;
			grid-template-areas:
				'a'
				'b'
				'c'
				'd'
				'e';
		}

		.work-card {
			min-height: 300px;
		}
	}
</style>
